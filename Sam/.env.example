# OSINT Investigation Platform — Environment Variables Template
# Copy this file to .env and fill in values before running.
# NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret

# ── Auth / Bootstrap Admin ─────────────────────────────────────────────────────
# Used ONLY when the users table is empty (first run). Change immediately.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe@123

# ── Database ───────────────────────────────────────────────────────────────────
# Note: @ in password must be URL-encoded as %40
DATABASE_URL=postgresql://copint_user:password%40here@localhost:5432/ai_copint_db

# ── Branding ───────────────────────────────────────────────────────────────────
# Absolute path to the police emblem/logo PNG file. Leave blank to hide the logo.
POLICE_BRAND_LOGO_PATH=

# ── External Intelligence APIs ─────────────────────────────────────────────────
OPENAI_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
BEHINDTHEEMAIL_API_KEY=
AIORNOT_API_KEY=
RAPIDAPI_KEY=
TRUECALLER_API_URL=https://truecaller-data2.p.rapidapi.com

# ── Visual Intelligence (Google Lens via SerpAPI + ImgBB relay) ────────────────
# Flow: image → ImgBB (temp public URL, 10-min expiry) → SerpAPI Google Lens
# Works on localhost and internal/intranet servers — only outbound connections needed.
SERPAPI_API_KEY=
# Free ImgBB API key from https://api.imgbb.com
IMGBB_API_KEY=
